# Google Drive — OAuth 2.0 as the folder owner's own account (NOT a service
# account: service accounts have no storage quota of their own, and personal
# Gmail accounts can't use Shared Drives / domain delegation to work around
# that). See README.md for how to generate the refresh token.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REFRESH_TOKEN=""
GOOGLE_DRIVE_FOLDER_ID=""

# OpenAI Whisper (speech-to-text)
OPENAI_API_KEY=""

# Anthropic Claude (meeting analysis)
ANTHROPIC_API_KEY=""

# Slack — optional. Without it, delivery is simulated (mode "MOCK").
SLACK_WEBHOOK_URL=""
