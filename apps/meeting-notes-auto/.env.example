# Google Drive — service account with the Drive API enabled. The JSON key's
# `client_email` must be added as an Editor to the target Drive folder.
# Paste either the raw JSON (single line) or a base64-encoded copy of it.
GOOGLE_SERVICE_ACCOUNT_JSON=""
GOOGLE_DRIVE_FOLDER_ID=""

# OpenAI Whisper (speech-to-text)
OPENAI_API_KEY=""

# Anthropic Claude (meeting analysis)
ANTHROPIC_API_KEY=""

# Slack — optional. Without it, delivery is simulated (mode "MOCK").
SLACK_WEBHOOK_URL=""
