# Database — Phase 1 uses Vercel Postgres. Locally, point at a local/dev Postgres instance.
DATABASE_URL="postgresql://orchestrator:orchestrator_dev_pw@localhost:5432/ai_content_orchestrator"

# Auth.js
AUTH_SECRET="generate-with-npx-auth-secret"
NEXTAUTH_URL="http://localhost:3000"
# Required for local/non-Vercel hosts (Vercel sets this automatically via its
# own VERCEL env var, so you normally don't need it in the Vercel dashboard).
AUTH_TRUST_HOST="true"

# Connector mode — "mock" is the only supported value in Phase 1.
CONNECTOR_MODE="mock"
